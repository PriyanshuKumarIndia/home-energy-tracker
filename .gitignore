# ------------------------------------------------------------
# Java / Maven
# ------------------------------------------------------------
**/target/
**/out/
**/build/

*.class
*.jar
*.war
*.ear

# Maven generated files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# ------------------------------------------------------------
# Spring Boot
# ------------------------------------------------------------

# Application logs
*.log
logs/
**/logs/

# Ignore local Spring configuration files
# IMPORTANT: Commit shared/non-sensitive configuration separately
application-local.yml
application.yml
application-local.yaml
application-local.properties

# Environment-specific configuration
application-dev-local.yml
application-dev-local.yaml
application-prod-local.yml
application-prod-local.yaml

